# .pylintrc — standard baseline for Python projects
# Generated by grimoire python-ci-lint-precheck skill.
# Adjust [MESSAGES CONTROL] and thresholds for your project.
#
# Usage:
#   pylint <package>/ --rcfile=.pylintrc
#   Or drop this file in the project root (pylint finds it automatically).

[MASTER]
# Allow pytest and other native extensions without triggering E0401
extension-pkg-allow-list=pytest

# Run pylint across multiple CPU cores
jobs=0

[MESSAGES CONTROL]
# Disable these globally — they are either pytest-specific false positives
# or style choices that conflict with common project conventions.
#
# W0621 redefined-outer-name  — pytest fixtures shadow their import by design
# C0114 missing-module-docstring — enforced by code review, not linting
# C0115 missing-class-docstring  — same
# C0116 missing-function-docstring — same
disable=
    C0114,
    C0115,
    C0116

# Do NOT disable globally:
#   E0401 import-error — fix via extension-pkg-allow-list, not blanket disable
#   R0914 too-many-locals — disable inline on the specific function if needed
#   W0621 redefined-outer-name — disable inline in each pytest test file

[FORMAT]
# Match black's default line length
max-line-length=88

# Allow longer lines in comments and docstrings (URLs etc.)
max-doc-length=120

[DESIGN]
# Raise thresholds slightly for data-heavy or algorithmic projects.
# Tighten these if your codebase is small and well-factored.
max-args=8
max-attributes=10
max-bool-expr=5
max-branches=12
max-locals=15
max-returns=6
max-statements=50
min-public-methods=1

[SIMILARITIES]
# Minimum lines of code that trigger a duplicate-code warning
min-similarity-lines=6
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes

[BASIC]
# Variable naming: allow single-letter loop vars and common short names
good-names=i,j,k,n,x,y,z,e,f,fp,fd,ok,id,_

[TYPECHECK]
# Suppress member checks on common dynamic attributes
ignored-classes=
    optparse.Values,
    thread._local,
    _thread._local,
    argparse.Namespace

[REPORTS]
# Compact output — one message per line, no summary table
output-format=text
reports=no
score=no
